using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;

// 灰烬地窟 · CRAWLER —— 阶段一：项目骨架 + 回合制地牢场景。
//
// 参考源：CleverRaven/Cataclysm-DDA（README 明示 CC-BY-SA 3.0，代码与内容
// 同许可；字体等有例外条款）。素材（贴图/音乐）在仓外 tileset/soundpack，
// 仓内只有数据表——本项目走"抄数据结构、美术自制"路线。
// 抄的是：回合制 10 步行动制、物品栏与装备槽、怪物 AI 状态机、
// 体力/负重/光照三维资源、JSON 驱动的内容表结构。
//
// Zan 路线：2D tile 图集 + 文字 UI（Canvas.DrawText / Gui 控件）。
// 后期接 Canvas.SpriteHandle / DrawSprites 做瓦片批。
//
// 环境变量：CRAWLER_SMOKE=1 / CRAWLER_FRAMES=<n> / CRAWLER_CAPTURE=<path.zpx>
public class Program {
    Form form;
    App app;
    GameShell shell;
    int frames = 0;
    int tick = 0;

    const int MapW = 40;
    const int MapH = 28;
    const int Tile = 24;

    // 地牢：0 地板 1 墙 2 熔渣 3 水
    int[] map = new int[MapW * MapH];
    bool[] seen = new bool[MapW * MapH];

    // 玩家
    int px = 20;
    int py = 14;
    int pHp = 100;
    int pStam = 100;
    int pLight = 8;

    // 怪物
    int mx = 28;
    int my = 10;
    int mHp = 40;

    // 当前层数（体力耗尽就下潜一层）
    int depth = 0;

    static void Main() {
        Program p = new Program();
        p.Run();
    }

    void Run() {
        form = Form.CreateDark("灰烬地窟 · CRAWLER", 1280, 800);
        app = form.GetApp();
        app.UseSkin("dark");
        Canvas.SetBackend(1);
        GenMap();
        // 外壳：存档（最深层数/最远回合/局数）+ 设置浮层。浮层是标准库控件，
        // 盖在直绘画面之上——Esc 开关。
        this.shell = new GameShell();
        form.Add(this.shell.Overlay().Root());
        app.Show();
        app.RequestRedraw();
        while (true) {
            int got = app.PollOneEvent();
            if (got < 0) { this.Finish(); break; }
            // Esc 开关设置浮层（只有真有事件时才看键码，否则会拿上一帧的
            // 残留值反复开关）。
            if (got == 1 && app.window.EventKind() == 4
                && app.window.EventKeyCode() == Keys.Escape()) {
                this.shell.Overlay().Toggle();
            }
            this.shell.Overlay().Tick();
            Tick();
            app.BeginFrame();
            Render();
            // 控件树叠在直绘之上：测量 → 排布 → 绘制。
            form.MeasureTree(app);
            form.Arrange(app.ShapeOffX(), app.ContentTop() + app.ShapeOffY(),
                app.ClientWidth(), app.ClientHeight() - app.ContentTop());
            form.RenderTree(app);
            app.RenderChrome("灰烬地窟 · CRAWLER");
            frames = frames + 1;
            string capture = Environment.GetEnvironmentVariable("CRAWLER_CAPTURE");
            if (capture != "" && frames == 60) {
                app.canvas.WritePixels(capture, 0, 0, app.ClientWidth(), app.ClientHeight());
                Console.WriteLine("CRAWLER_CAPTURE " + Convert.ToString(app.ClientWidth())
                    + "x" + Convert.ToString(app.ClientHeight()));
            }
            app.PresentFrame();
            if (IsSmoke() && frames >= SmokeFrames()) {
                Console.WriteLine("CRAWLER_SMOKE_OK frames=" + Convert.ToString(frames)
                    + " turn=" + Convert.ToString(tick));
                this.Finish();
                break;
            }
            app.RequestRedraw();
            Window.SleepMs(16);
        }
    }

    // 收尾：存档落盘 + 打印读回值（测试脚本靠这行验证"跑两遍读得到"）。
    void Finish() {
        this.shell.RecordRun(this.depth, this.tick);
        this.shell.Save();
        Console.WriteLine("CRAWLER_SAVE best=" + Convert.ToString(this.shell.Best())
            + " turns=" + Convert.ToString(this.shell.Turns())
            + " runs=" + Convert.ToString(this.shell.Runs()));
    }

    bool IsSmoke() {
        return Environment.GetEnvironmentVariable("CRAWLER_SMOKE") == "1";
    }

    int SmokeFrames() {
        string v = Environment.GetEnvironmentVariable("CRAWLER_FRAMES");
        if (v == "") { return 90; }
        return Convert.ToInt32(v);
    }

    // 简易地牢生成：房间 + 走廊
    void GenMap() {
        for (int i = 0; i < map.Length; i = i + 1) { map[i] = 1; }
        for (int ry = 3; ry < MapH - 3; ry = ry + 1) {
            for (int rx = 3; rx < MapW - 3; rx = rx + 1) {
                bool inRoom = (rx >= 6 && rx <= 16 && ry >= 6 && ry <= 12)
                           || (rx >= 22 && rx <= 32 && ry >= 14 && ry <= 20);
                if (inRoom) { map[ry * MapW + rx] = 0; }
            }
        }
        // 走廊
        for (int x = 16; x <= 22; x = x + 1) { map[9 * MapW + x] = 0; }
        for (int y = 9; y <= 17; y = y + 1) { map[y * MapW + 22] = 0; }
        // 熔渣池与水
        map[8 * MapW + 8] = 2;
        map[8 * MapW + 9] = 2;
        map[19 * MapW + 30] = 3;
    }

    // 一回合 = 玩家走一步 + 怪物行动
    void Tick() {
        tick = tick + 1;
        // 玩家沿矩形路线自动行走（骨架阶段代替输入）
        int step = tick % 80;
        if (step < 40) { px = px + 1; if (px > 15) { px = 15; } }
        else { py = py + 1; if (py > 12) { py = 6; } }
        if (px < 6) { px = 6; }
        if (py < 6) { py = 6; }
        // 体力消耗档（1/2/3）决定每回合掉多少体力——设置不是摆设。
        pStam = pStam - this.shell.StaminaCost();
        if (pStam <= 0) {
            // 体力耗尽：下潜一层，补满体力，重开这一层。
            depth = depth + 1;
            pStam = 100;
            GenMap();
            for (int i = 0; i < seen.Length; i = i + 1) { seen[i] = false; }
            px = 20; py = 14; mx = 28; my = 10; mHp = 40;
        }
        // 视野：视野半径档（4/8/12 格）决定照多远。
        pLight = this.shell.LightRadius();
        for (int dy = -pLight; dy <= pLight; dy = dy + 1) {
            for (int dx = -pLight; dx <= pLight; dx = dx + 1) {
                int nx = px + dx; int ny = py + dy;
                if (nx < 0 || ny < 0 || nx >= MapW || ny >= MapH) { continue; }
                if (dx * dx + dy * dy > pLight * pLight) { continue; }
                seen[ny * MapW + nx] = true;
            }
        }
        // 怪物朝玩家靠：凶险档决定每回合追几步。
        int steps = this.shell.Difficulty();
        for (int s = 0; s < steps; s = s + 1) {
            int mdx = px - mx;
            int mdy = py - my;
            if (mdx == 0 && mdy == 0) { break; }
            int nx = mx + (mdx > 0 ? 1 : (mdx < 0 ? -1 : 0));
            int ny = my + (mdy > 0 ? 1 : (mdy < 0 ? -1 : 0));
            if (nx < 0 || ny < 0 || nx >= MapW || ny >= MapH) { break; }
            if (map[ny * MapW + nx] == 0) { mx = nx; my = ny; }
        }
        int dist = (px - mx) * (px - mx) + (py - my) * (py - my);
        // 接触伤害随凶险档升高。
        if (dist < 4) { pHp = pHp - (1 + this.shell.Difficulty()); mHp = mHp - 5; }
        if (pHp <= 0) {
            // 死了：这一局到此为止，记下最深层数后重开一局。
            this.shell.RecordRun(this.depth, this.tick);
            depth = 0;
            pHp = 100; pStam = 100;
            px = 20; py = 14; mx = 28; my = 10; mHp = 40;
            GenMap();
            for (int i = 0; i < seen.Length; i = i + 1) { seen[i] = false; }
        }
    }

    void Render() {
        Canvas c = app.canvas;
        int w = c.Width();
        int h = c.Height();
        c.FillRect(0, 0, w, h, 0xFF0D0B0A);
        int ox = 40;
        int oy = 90;
        for (int y = 0; y < MapH; y = y + 1) {
            for (int x = 0; x < MapW; x = x + 1) {
                if (!seen[y * MapW + x]) { continue; }
                int tx = ox + x * Tile;
                int ty = oy + y * Tile;
                int t = map[y * MapW + x];
                if (t == 0) { c.FillRect(tx, ty, Tile, Tile, 0xFF2A2724); }
                else if (t == 1) { c.FillRect(tx, ty, Tile, Tile, 0xFF141210); }
                else if (t == 2) { c.FillRect(tx, ty, Tile, Tile, 0xFF7A2E12); }
                else { c.FillRect(tx, ty, Tile, Tile, 0xFF1E3A5A); }
                c.DrawRect(tx, ty, Tile, Tile, 0xFF38332D, 1);
            }
        }
        // 怪物（视野内）
        if (seen[my * MapW + mx]) {
            c.FillRect(ox + mx * Tile + 4, oy + my * Tile + 4, Tile - 8, Tile - 8, 0xFFB03A3A);
        }
        // 玩家
        c.FillRect(ox + px * Tile + 3, oy + py * Tile + 3, Tile - 6, Tile - 6, 0xFFD8CFA0);
        c.DrawRect(ox + px * Tile + 3, oy + py * Tile + 3, Tile - 6, Tile - 6, 0xFF6A6250, 2);
        // HUD
        c.DrawText(24, 24, "灰烬地窟 · 回合制地牢骨架", 0xFFE8DFC8, 20);
        c.FillRect(24, 52, 240, 14, 0xFF241E1A);
        c.FillRect(24, 52, 240 * pHp / 100, 14, 0xFF9A3B32);
        c.DrawText(274, 52, "HP " + Convert.ToString(pHp), 0xFFE8DFC8, 14);
        c.FillRect(24, 70, 240, 10, 0xFF241E1A);
        c.FillRect(24, 70, 240 * pStam / 100, 10, 0xFF7E7A46);
        c.DrawText(274, 68, "STA " + Convert.ToString(pStam), 0xFFE8DFC8, 14);
        c.DrawText(24, h - 76, "Esc 打开设置", 0xC09C937E, 14);
        c.DrawText(24, h - 52, "回合 " + Convert.ToString(tick) + "  位置 " + Convert.ToString(px)
            + "," + Convert.ToString(py) + "  怪物HP " + Convert.ToString(mHp)
            + "  第 " + Convert.ToString(depth) + " 层", 0xFF9C937E, 14);
        c.DrawText(24, h - 28, "TODO 素材：32x32 瓦片集（地面6/墙6/物件8/熔渣/水）+ 怪物10种x4帧 + 物品图标30 + 字体",
            0xB09C937E, 14);
    }
}
