using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Game.Kit;

// 地牢画面：位图贴图 + 迷雾 + 火光 + HUD + 菜单/结算面板。
//
// 贴图路线（按 REAL_GAME_STANDARD 第 4 节）：地砖/墙是**底板位图**
// （一张 128×128 切 4 块取景变化），角色/怪物是**两帧朝向精灵表**
// （左右各一帧，见 CrawlerFacing），物品各自一张主体位图，
// 面板与按钮是**九宫格美术底板**（CDraw 裁源矩形自拼，引擎没有
// border-image）。找不到贴图就退回纯色块，不崩。
//
// 三条规矩：
//   颜色一律从 CrawlerPalette 取（同一语义只有一个出处）；
//   朝向一律按 CrawlerFacing 的取帧规则从两帧精灵表里取
//   （引擎运行时不能翻转贴图，方向只能离线烘焙）；
//   迷雾按"到玩家的距离"连续变浓，视野边界是一段渐变，不是一刀切的方块。
public class CrawlerView {
    public const int DesignW = 1280;
    public const int DesignH = 800;
    public const int Tile = 32;
    public const int ViewCols = 30;
    public const int ViewRows = 16;
    public const int ViewW = CrawlerView.ViewCols * CrawlerView.Tile;
    public const int ViewH = CrawlerView.ViewRows * CrawlerView.Tile;
    public const int ViewY = 76;
    public const int HudH = 70;
    public const int LogY = CrawlerView.ViewY + CrawlerView.ViewH + 12;
    // 九宫格角切片边长（源图像素）：与 ui_board.png / ui_button*.png 对齐。
    public const int BoardCorner = 16;
    public const int ButtonCorner = 12;
    // 地砖/墙变体图里单块变体的边长（源图像素）。
    public const int VariantSize = 64;

    public string floorPath = "";
    public string wallPath = "";
    public string doorPath = "";
    public string stairsPath = "";
    public string playerPath = "";
    public string slimePath = "";
    public string skeletonPath = "";
    public string batPath = "";
    public string coinPath = "";
    public string potionPath = "";
    public string keyPath = "";
    public string torchPath = "";
    public string mossPath = "";
    public string puddlePath = "";
    public string shadowPath = "";
    public string glowPath = "";
    public string lampPath = "";
    public string boardPath = "";
    public string buttonPath = "";
    public string buttonHoverPath = "";
    public string buttonDownPath = "";
    public string buttonPrimaryPath = "";
    public string buttonPrimaryHoverPath = "";
    public string buttonPrimaryDownPath = "";
    public bool assetsReady;
    // 地图视口左边界：每帧按舞台宽度居中（窗口不是 1280 时也不偏）。
    public int viewX = (CrawlerView.DesignW - CrawlerView.ViewW) / 2;

    public void LoadAssets() {
        this.floorPath = CrawlerView.Asset("assets/floor.png");
        this.wallPath = CrawlerView.Asset("assets/wall.png");
        this.doorPath = CrawlerView.Asset("assets/door.png");
        this.stairsPath = CrawlerView.Asset("assets/stairs.png");
        this.playerPath = CrawlerView.Asset("assets/player_sheet.png");
        this.slimePath = CrawlerView.Asset("assets/slime_sheet.png");
        this.skeletonPath = CrawlerView.Asset("assets/skeleton_sheet.png");
        this.batPath = CrawlerView.Asset("assets/bat_sheet.png");
        this.coinPath = CrawlerView.Asset("assets/coin.png");
        this.potionPath = CrawlerView.Asset("assets/potion.png");
        this.keyPath = CrawlerView.Asset("assets/key.png");
        this.torchPath = CrawlerView.Asset("assets/torch.png");
        this.mossPath = CrawlerView.Asset("assets/moss.png");
        this.puddlePath = CrawlerView.Asset("assets/puddle.png");
        this.shadowPath = CrawlerView.Asset("assets/shadow.png");
        this.glowPath = CrawlerView.Asset("assets/glow.png");
        this.lampPath = CrawlerView.Asset("assets/lamp.png");
        this.boardPath = CrawlerView.Asset("assets/ui_board.png");
        this.buttonPath = CrawlerView.Asset("assets/ui_button.png");
        this.buttonHoverPath = CrawlerView.Asset("assets/ui_button_hi.png");
        this.buttonDownPath = CrawlerView.Asset("assets/ui_button_down.png");
        this.buttonPrimaryPath = CrawlerView.Asset("assets/ui_button_primary.png");
        this.buttonPrimaryHoverPath = CrawlerView.Asset("assets/ui_button_primary_hi.png");
        this.buttonPrimaryDownPath = CrawlerView.Asset("assets/ui_button_primary_down.png");
        this.assetsReady = this.floorPath != "" && this.playerPath != "";
    }

    // 磁盘优先 → 内嵌兜底 → 空串（调用方走纯色兜底）。
    static string Asset(string rel) {
        string p = Assets.Find(rel);
        if (p != null && p != "" && File.Exists(p)) { return p; }
        try {
            if (File.EmbedExists(rel)) {
                byte[] b = File.ReadAllBytes(rel);
                string key = "mem:" + rel;
                Canvas.ImageLoadMem(key, b, b.Length);
                return key;
            }
        } catch (Exception) {
        }
        return "";
    }

    // ----- 绘制原语 -------------------------------------------------------
    //
    // 九宫格切图、裁源贴图、文字（普通/投影/居中）都归公共包：
    // CKitSlice.NineSlice / CDraw.BlitImageSrc / CText.DrawShadowPx。此前
    // 这一件事在 8 个游戏项目各写一份，签名漂成 8 种，投影偏移也各写各的。
    //
    // 素材解析（磁盘优先 → 内嵌兜底 → 空串）在 Asset() 里，那是资源策略
    // 不是绘制原语；包里 CDraw.BlitSource 现在也认 "mem:" 键，所以内嵌
    // 兜底出来的键可以直接贴。

    void Fill(Canvas c, int x, int y, int w, int h, int color) {
        CDraw.FillRect(c, x, y, w, h, color);
    }

    void FillRound(Canvas c, int x, int y, int w, int h, int rad, int color) {
        CDraw.RoundRectFill(c, x, y, w, h, rad,
            (color >> 16) & 0xFF, (color >> 8) & 0xFF, color & 0xFF, (color >> 24) & 0xFF);
    }

    // 面板底板：有美术底板用底板，没有退回半透明圆角矩形。
    void Panel(Canvas c, int x, int y, int w, int h) {
        if (this.boardPath != "") {
            CKitSlice.NineSlice(c, this.boardPath, x, y, w, h, CrawlerView.BoardCorner);
            return;
        }
        this.FillRound(c, x, y, w, h, 6, CrawlerPalette.PanelBgSoft);
        CDraw.RingRect(c, x, y, w, h, 2,
            (CrawlerPalette.Brass >> 16) & 0xFF, (CrawlerPalette.Brass >> 8) & 0xFF,
            CrawlerPalette.Brass & 0xFF, 255);
    }

    // ----- 地图 -----------------------------------------------------------

    int CamX(CrawlerGame g) {
        int raw = g.px * CrawlerView.Tile + CrawlerView.Tile / 2 - CrawlerView.ViewW / 2;
        int maxX = CrawlerMap.Width * CrawlerView.Tile - CrawlerView.ViewW;
        if (raw < 0) { raw = 0; }
        if (raw > maxX) { raw = maxX; }
        return raw;
    }

    int CamY(CrawlerGame g) {
        int raw = g.py * CrawlerView.Tile + CrawlerView.Tile / 2 - CrawlerView.ViewH / 2;
        int maxY = CrawlerMap.Height * CrawlerView.Tile - CrawlerView.ViewH;
        if (raw < 0) { raw = 0; }
        if (raw > maxY) { raw = maxY; }
        return raw;
    }

    // 地图坐标的稳定哈希：点缀物（火把/苔藓/积水）的摆放靠它，
    // 同一个格子每次都长在同一个地方（换地图也不会乱跳）。
    static int CellHash(int mx, int my) {
        int h = (mx * 7919 + my * 104729) % 65521;
        if (h < 0) { h = h + 65521; }
        return h;
    }

    // 一格地面/墙/门/楼梯。variant 让同一张底板切出 4 种取景。
    void DrawTile(Canvas c, int kind, int px, int py, int variant, int mx, int my) {
        if (kind == CrawlerMap.Wall) {
            if (this.wallPath != "") {
                CDraw.BlitImageSrc(c, this.wallPath, px, py, CrawlerView.Tile, CrawlerView.Tile,
                    (variant % 2) * CrawlerView.VariantSize, (variant / 2) * CrawlerView.VariantSize,
                    CrawlerView.VariantSize, CrawlerView.VariantSize);
            } else {
                this.Fill(c, px, py, CrawlerView.Tile, CrawlerView.Tile, CrawlerPalette.StoneDark);
            }
            return;
        }
        if (kind == CrawlerMap.Door) {
            if (this.doorPath != "") {
                CDraw.BlitImageSrc(c, this.doorPath, px, py, CrawlerView.Tile, CrawlerView.Tile, 0, 0, 0, 0);
            } else {
                this.Fill(c, px, py, CrawlerView.Tile, CrawlerView.Tile, CrawlerPalette.DoorWood);
            }
            return;
        }
        if (kind == CrawlerMap.Stairs) {
            if (this.stairsPath != "") {
                CDraw.BlitImageSrc(c, this.stairsPath, px, py, CrawlerView.Tile, CrawlerView.Tile, 0, 0, 0, 0);
            } else {
                this.Fill(c, px, py, CrawlerView.Tile, CrawlerView.Tile, CrawlerPalette.StairHole);
            }
            return;
        }
        if (this.floorPath != "") {
            CDraw.BlitImageSrc(c, this.floorPath, px, py, CrawlerView.Tile, CrawlerView.Tile,
                (variant % 2) * CrawlerView.VariantSize, (variant / 2) * CrawlerView.VariantSize,
                CrawlerView.VariantSize, CrawlerView.VariantSize);
        } else {
            this.Fill(c, px, py, CrawlerView.Tile, CrawlerView.Tile, CrawlerPalette.StoneFloor);
        }
    }

    // 点缀物：墙上的火把、地上的苔藓与积水。纯装饰，不参与玩法。
    void DrawDecor(Canvas c, int kind, int px, int py, int mx, int my) {
        int h = CrawlerView.CellHash(mx, my);
        if (kind == CrawlerMap.Wall) {
            // 火把：只在"下方是地板"的墙上挂（挂太高看不见），每 9 格一处。
            if (this.torchPath == "") { return; }
            if (h % 9 != 0) { return; }
            CDraw.BlitImageSrc(c, this.torchPath, px + 7, py - 6, 18, 27, 0, 0, 0, 0);
            return;
        }
        if (this.mossPath != "" && h % 11 == 0) {
            CDraw.BlitImageSrc(c, this.mossPath, px + 3, py + 4, 26, 26, 0, 0, 0, 0);
        }
        if (this.puddlePath != "" && h % 13 == 3) {
            CDraw.BlitImageSrc(c, this.puddlePath, px + 3, py + 8, 26, 20, 0, 0, 0, 0);
        }
    }

    // 迷雾浓度：距离玩家越远越浓，视野边界是一段渐变（不是一刀切的方块）。
    // d2 是"格距平方"，lo/hi 是渐变起止的格距平方（都乘 16 放在 1/4 格单位里）。
    static int FogAlpha(int d2, int lo, int hi) {
        if (d2 <= lo) { return 0; }
        if (d2 >= hi) { return 0xD0; }
        return (d2 - lo) * 0xD0 / (hi - lo);
    }

    // 一格迷雾：按 2×2 分块分别算浓度，边界是斜的软边。
    void DrawFog(Canvas c, int sx, int sy, int mx, int my, int px, int py, int radius) {
        int r1 = radius - 1;
        if (r1 < 0) { r1 = 0; }
        int r2 = radius + 1;
        int lo = r1 * r1 * 16;
        int hi = r2 * r2 * 16;
        if (hi <= lo) { return; }
        int q = CrawlerView.Tile / 2;
        for (int qy = 0; qy < 2; qy = qy + 1) {
            for (int qx = 0; qx < 2; qx = qx + 1) {
                int dx4 = (mx - px) * 4 + (qx == 0 ? -1 : 1);
                int dy4 = (my - py) * 4 + (qy == 0 ? -1 : 1);
                int a = CrawlerView.FogAlpha(dx4 * dx4 + dy4 * dy4, lo, hi);
                if (a <= 0) { continue; }
                this.Fill(c, sx + qx * q, sy + qy * q, q, q,
                    (a << 24) | (CrawlerPalette.Fog & 0xFFFFFF));
            }
        }
    }

    void DrawItem(Canvas c, CrawlerItem it, int px, int py) {
        string path = "";
        if (it.kind == CrawlerEntities.PotionItem) { path = this.potionPath; }
        else if (it.kind == CrawlerEntities.KeyItem) { path = this.keyPath; }
        else { path = this.coinPath; }
        if (path != "") {
            CDraw.BlitImageSrc(c, path, px + 4, py + 4, 24, 24, 0, 0, 0, 0);
            return;
        }
        if (it.kind == CrawlerEntities.PotionItem) { this.Fill(c, px + 8, py + 8, 16, 16, CrawlerPalette.Potion); }
        else if (it.kind == CrawlerEntities.KeyItem) { this.Fill(c, px + 8, py + 8, 16, 16, CrawlerPalette.KeyGold); }
        else { this.Fill(c, px + 8, py + 8, 16, 16, CrawlerPalette.Gold); }
    }

    // 落地投影：椭圆暗影贴在脚下，主体才不像"贴"在地面上。
    void DrawShadow(Canvas c, int px, int py, int w) {
        if (this.shadowPath == "") { return; }
        int h = w / 2;
        CDraw.BlitImageSrc(c, this.shadowPath, px + CrawlerView.Tile / 2 - w / 2,
            py + CrawlerView.Tile - h + 2, w, h, 0, 0, 0, 0);
    }

    void DrawEnemy(Canvas c, CrawlerEnemy e, int px, int py) {
        string path = this.slimePath;
        if (e.kind == CrawlerEntities.SkeletonKind) { path = this.skeletonPath; }
        else if (e.kind == CrawlerEntities.BatKind) { path = this.batPath; }
        this.DrawShadow(c, px, py, 26);
        if (path != "") {
            CDraw.BlitImageSrc(c, path, px, py, CrawlerView.Tile, CrawlerView.Tile,
                CrawlerFacing.EnemySrcX(e.facingRight), 0,
                CrawlerFacing.EnemyFrameW, CrawlerFacing.EnemyFrameH);
        } else {
            this.Fill(c, px + 4, py + 4, 24, 24, CrawlerPalette.EnemyFallback);
        }
        // 血条（界面部件，几何绘制）：贴图之上一条细血条。
        int w = 24;
        int barY = py + 1;
        this.Fill(c, px + 4, barY, w, 3, CrawlerPalette.BarBg);
        int filled = 0;
        if (e.maxHp > 0) { filled = w * e.hp / e.maxHp; }
        if (filled < 0) { filled = 0; }
        if (filled > w) { filled = w; }
        this.Fill(c, px + 4, barY, filled, 3, CrawlerPalette.EnemyHp);
    }

    // 地图本体：先铺底，再画"记住"的格子（带迷雾压暗），
    // 最后画火光与当前视野里的怪与玩家。
    void DrawMap(Canvas c, int w, int h, CrawlerGame g) {
        CrawlerMap m = g.map;
        this.Fill(c, 0, 0, w, h, CrawlerPalette.Void);
        if (m == null) { return; }
        int x0 = this.CamX(g) / CrawlerView.Tile;
        int y0 = this.CamY(g) / CrawlerView.Tile;
        this.Fill(c, this.viewX, CrawlerView.ViewY, CrawlerView.ViewW, CrawlerView.ViewH, CrawlerPalette.Void);
        for (int ty = 0; ty < CrawlerView.ViewRows; ty = ty + 1) {
            for (int tx = 0; tx < CrawlerView.ViewCols; tx = tx + 1) {
                int mx = x0 + tx;
                int my = y0 + ty;
                if (!m.InBounds(mx, my)) { continue; }
                if (!m.IsSeen(mx, my)) { continue; }
                int px = this.viewX + tx * CrawlerView.Tile;
                int py = CrawlerView.ViewY + ty * CrawlerView.Tile;
                int kind = m.At(mx, my);
                int variant = (mx * 7 + my * 13) % 4;
                this.DrawTile(c, kind, px, py, variant, mx, my);
                this.DrawDecor(c, kind, px, py, mx, my);
                CrawlerItem it = g.ItemAt(mx, my);
                if (it != null) { this.DrawItem(c, it, px, py); }
            }
        }
        // 迷雾：按到玩家的距离连续变浓（视野边缘是渐变带）。
        for (int ty = 0; ty < CrawlerView.ViewRows; ty = ty + 1) {
            for (int tx = 0; tx < CrawlerView.ViewCols; tx = tx + 1) {
                int mx = x0 + tx;
                int my = y0 + ty;
                if (!m.InBounds(mx, my)) { continue; }
                if (!m.IsSeen(mx, my)) { continue; }
                int fpx = this.viewX + tx * CrawlerView.Tile;
                int fpy = CrawlerView.ViewY + ty * CrawlerView.Tile;
                this.DrawFog(c, fpx, fpy, mx, my, g.px, g.py, g.visionRadius);
            }
        }
        int ppx = this.viewX + (g.px - x0) * CrawlerView.Tile;
        int ppy = CrawlerView.ViewY + (g.py - y0) * CrawlerView.Tile;
        // 火光：提灯把身边照亮（"地牢里有光源"的感觉）。
        if (this.glowPath != "") {
            int rr = (g.visionRadius + 1) * CrawlerView.Tile;
            CDraw.BlitImageSrc(c, this.glowPath, ppx + CrawlerView.Tile / 2 - rr,
                ppy + CrawlerView.Tile / 2 - rr, rr * 2, rr * 2, 0, 0, 0, 0);
        }
        // 提灯的光池落在朝向的一侧——玩家面朝哪边，一眼看得出来。
        if (this.lampPath != "") {
            int dir = g.facingRight ? 1 : -1;
            CDraw.BlitImageSrc(c, this.lampPath, ppx + CrawlerView.Tile / 2 + dir * 13 - 26,
                ppy + CrawlerView.Tile / 2 - 26, 52, 52, 0, 0, 0, 0);
        }
        for (int i = 0; i < g.enemies.Count; i = i + 1) {
            CrawlerEnemy e = g.enemies[i];
            if (e.dead) { continue; }
            if (!m.IsVisible(e.x, e.y)) { continue; }
            int px = this.viewX + (e.x - x0) * CrawlerView.Tile;
            int py = CrawlerView.ViewY + (e.y - y0) * CrawlerView.Tile;
            this.DrawEnemy(c, e, px, py);
        }
        this.DrawShadow(c, ppx, ppy, 28);
        if (this.playerPath != "") {
            CDraw.BlitImageSrc(c, this.playerPath, ppx, ppy, CrawlerView.Tile, CrawlerView.Tile,
                CrawlerFacing.PlayerSrcX(g.facingRight), 0,
                CrawlerFacing.PlayerFrameW, CrawlerFacing.PlayerFrameH);
        } else {
            this.Fill(c, ppx + 4, ppy + 4, 24, 24, CrawlerPalette.PlayerFallback);
        }
    }

    // ----- HUD ------------------------------------------------------------

    void Bar(Canvas c, int x, int y, int w, int h, int value, int maxValue, int color) {
        this.Fill(c, x, y, w, h, CrawlerPalette.BarBg);
        int filled = 0;
        if (maxValue > 0) { filled = w * value / maxValue; }
        if (filled < 0) { filled = 0; }
        if (filled > w) { filled = w; }
        this.Fill(c, x, y, filled, h, color);
        // 高光条：血条不是纯色块。
        if (filled > 2) {
            this.Fill(c, x, y, filled, 2, CrawlerPalette.HpSoft);
        }
        CDraw.RingRect(c, x, y, w, h, 1, 0x60, 0x50, 0x38, 255);
    }

    void DrawHud(Canvas c, int w, CrawlerGame g) {
        this.Panel(c, 10, 6, w - 20, 60);
        CText.DrawShadowPx(c, "地底爬行 · CRAWLER", 26, 12, 20, CrawlerPalette.RustGold, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "第 " + Convert.ToString(g.depth) + " 层 / 目标第 "
            + Convert.ToString(CrawlerGame.GoalDepth) + " 层", 300, 16, 16, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        this.Bar(c, 26, 40, 220, 14, g.hp, g.maxHp, CrawlerPalette.Hp);
        CText.DrawShadowPx(c, "HP " + Convert.ToString(g.hp) + "/" + Convert.ToString(g.maxHp),
            256, 39, 15, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "金币 " + Convert.ToString(g.gold), 400, 39, 15, CrawlerPalette.Gold, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "钥匙 " + Convert.ToString(g.keys), 520, 39, 15, CrawlerPalette.KeyGold, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "药水 " + Convert.ToString(g.potions), 630, 39, 15, CrawlerPalette.Potion, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "击杀 " + Convert.ToString(g.kills), 730, 39, 15, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "回合 " + Convert.ToString(g.turn), 830, 39, 15, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "本层剩余 " + Convert.ToString(g.AliveEnemies()) + " 怪",
            940, 39, 15, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
    }

    // 底部：消息日志 + 怪物情报 + 操作提示（或战斗面板）。
    void DrawBottom(Canvas c, int w, int h, CrawlerGame g) {
        int panelY = h - 204;
        int floorY = CrawlerView.ViewY + CrawlerView.ViewH + 6;
        if (panelY < floorY) { panelY = floorY; }
        // 左：消息日志。
        this.Panel(c, 10, panelY, 680, 120);
        CText.DrawShadowPx(c, "地牢回响", 26, panelY + 8, 15, CrawlerPalette.RustGold, CrawlerPalette.TextShadow, 1, 2);
        int i = 0;
        for (int k = g.log.Count - 1; k >= 0 && i < 4; k = k - 1) {
            int fade = 0xE8DFC8 - i * 0x30;
            int col = 0xFF000000 | (fade & 0xFFFFFF);
            CText.DrawShadowPx(c, g.log[k], 26, panelY + 32 + i * 21, 15, col, CrawlerPalette.TextShadow, 1, 2);
            i = i + 1;
        }
        // 右：本层怪物情报。
        int bx = w - 330;
        this.Panel(c, bx, panelY, 320, 120);
        CText.DrawShadowPx(c, "本层怪物", bx + 16, panelY + 8, 15, CrawlerPalette.RustGold, CrawlerPalette.TextShadow, 1, 2);
        int[] kinds = new int[] { CrawlerEntities.SlimeKind, CrawlerEntities.SkeletonKind,
            CrawlerEntities.BatKind };
        for (int k = 0; k < kinds.Length; k = k + 1) {
            int kind = kinds[k];
            string line = CrawlerEntities.EnemyName(kind) + "  HP "
                + Convert.ToString(CrawlerEntities.EnemyHp(kind, g.depth))
                + "  伤害 " + Convert.ToString(CrawlerEntities.EnemyDamage(kind, g.depth));
            CText.DrawShadowPx(c, line, bx + 16, panelY + 32 + k * 21, 14, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        }
        // 底部操作提示。
        CText.DrawShadowPx(c, "方向键 / WASD 移动    空格 攻击    F 喝药    R 逃跑    Esc 设置",
            26, panelY + 128, 15, CrawlerPalette.Mist, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "走到楼梯就下潜一层；怪越来越多，也越来越疼。",
            26, panelY + 150, 14, CrawlerPalette.Mist, CrawlerPalette.TextShadow, 1, 2);
        if (g.state == CrawlerGame.Combat && g.foe != null) {
            this.DrawCombatBar(c, w, h, g, g.foe, panelY);
        }
    }

    void DrawCombatBar(Canvas c, int w, int h, CrawlerGame g, CrawlerEnemy foe, int panelY) {
        int bw = 640;
        int bx = w / 2 - bw / 2;
        int by = panelY - 24;
        this.Panel(c, bx, by, bw, 96);
        CText.DrawShadowPx(c, "战斗：" + CrawlerEntities.EnemyName(foe.kind),
            bx + 20, by + 10, 18, CrawlerPalette.HpSoft, CrawlerPalette.TextShadow, 1, 2);
        this.Bar(c, bx + 150, by + 14, 260, 14, foe.hp, foe.maxHp, CrawlerPalette.Hp);
        CText.DrawShadowPx(c, foe.hp + "/" + Convert.ToString(foe.maxHp)
            + "   伤害 " + Convert.ToString(foe.dmg), bx + 420, by + 13, 15, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "空格 攻击    F 喝药    R 逃跑    你 HP "
            + Convert.ToString(g.hp) + "/" + Convert.ToString(g.maxHp),
            bx + 20, by + 44, 15, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
    }

    // 游戏中画面：地图 + HUD + 底部面板。
    void DrawGame(Canvas c, int w, int h, CrawlerGame g) {
        this.viewX = (w - CrawlerView.ViewW) / 2;
        if (this.viewX < 0) { this.viewX = 0; }
        this.DrawMap(c, w, h, g);
        this.DrawHud(c, w, g);
        this.DrawBottom(c, w, h, g);
    }

    // ----- 菜单 -----------------------------------------------------------

    void DrawMenu(Canvas c, int w, int h, int bestDepth, int totalGold,
                  int totalKills, int clears, int runs) {
        this.Fill(c, 0, 0, w, h, CrawlerPalette.Void);
        // 背景：地砖铺底 + 压暗，菜单不是空背景板。
        if (this.floorPath != "") {
            for (int ty = 0; ty < h / 64 + 1; ty = ty + 1) {
                for (int tx = 0; tx < w / 64 + 1; tx = tx + 1) {
                    CDraw.BlitImageSrc(c, this.floorPath, tx * 64, ty * 64, 64, 64,
                        (tx % 2) * CrawlerView.VariantSize, (ty % 2) * CrawlerView.VariantSize,
                        CrawlerView.VariantSize, CrawlerView.VariantSize);
                }
            }
            this.Fill(c, 0, 0, w, h, CrawlerPalette.MenuMask);
        }
        CText.DrawCenteredShadowPx(c, "地底爬行 · CRAWLER", w / 2, 150, 52, CrawlerPalette.RustGold, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawCenteredShadowPx(c, "回合制地牢探险 —— 走到底，深到第 5 层就是胜利",
            w / 2, 216, 18, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        int bx = w / 2 - 200;
        this.Panel(c, bx, 268, 400, 132);
        CText.DrawShadowPx(c, "累计战绩", bx + 24, 282, 18, CrawlerPalette.RustGold, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "最深层数    " + Convert.ToString(bestDepth), bx + 24, 312, 16, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "累计金币    " + Convert.ToString(totalGold), bx + 24, 336, 16, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "累计击杀    " + Convert.ToString(totalKills), bx + 214, 312, 16, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "通关次数    " + Convert.ToString(clears), bx + 214, 336, 16, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "开局次数    " + Convert.ToString(runs), bx + 24, 360, 16, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawCenteredShadowPx(c, "方向键 / WASD 移动    空格攻击    F 喝药    R 逃跑",
            w / 2, 430, 16, CrawlerPalette.Mist, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawCenteredShadowPx(c, "Esc 打开设置", w / 2, 456, 14, CrawlerPalette.Mist, CrawlerPalette.TextShadow, 1, 2);
    }

    // ----- 结算 -----------------------------------------------------------

    void DrawResult(Canvas c, CrawlerGame g, int w, int h, int bestDepth,
                    int totalGold, int totalKills, int clears, int runs) {
        this.Fill(c, 0, 0, w, h, CrawlerPalette.ResultMask);
        int bx = w / 2 - 260;
        int by = 150;
        this.Panel(c, bx, by, 520, 420);
        bool won = g.state == CrawlerGame.Won;
        CText.DrawCenteredShadowPx(c, won ? "探险成功" : "你死了", w / 2, by + 26, 40,
            won ? CrawlerPalette.Success : CrawlerPalette.Danger, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawCenteredShadowPx(c, "第 " + Convert.ToString(g.depth) + " 层 · 回合 "
            + Convert.ToString(g.turn) + " · 用时 "
            + Convert.ToString(g.ElapsedMs() / 1000) + " 秒",
            w / 2, by + 82, 17, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        int ly = by + 124;
        CText.DrawShadowPx(c, "本局击杀      " + Convert.ToString(g.kills), bx + 40, ly, 17, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "本局金币      " + Convert.ToString(g.gold), bx + 40, ly + 30, 17, CrawlerPalette.Parchment, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "累计最深层数  " + Convert.ToString(bestDepth), bx + 40, ly + 60, 17, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "累计金币      " + Convert.ToString(totalGold), bx + 40, ly + 90, 17, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "累计击杀      " + Convert.ToString(totalKills), bx + 272, ly + 60, 17, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "通关次数      " + Convert.ToString(clears), bx + 272, ly + 90, 17, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
        CText.DrawShadowPx(c, "开局次数      " + Convert.ToString(runs), bx + 272, ly + 120, 17, CrawlerPalette.SlateText, CrawlerPalette.TextShadow, 1, 2);
    }

    // ----- 按钮 -----------------------------------------------------------

    // 三态按钮：常态 / 悬停 / 按下各有美术底板，没有底板才退回纯色。
    void DrawButton(Canvas c, string label, int x, int y, int w, int h,
                    bool primary, bool hover, bool pressed) {
        string path = "";
        if (primary) {
            path = this.buttonPrimaryPath;
            if (pressed) { path = this.buttonPrimaryDownPath; }
            else if (hover) { path = this.buttonPrimaryHoverPath; }
        } else {
            path = this.buttonPath;
            if (pressed) { path = this.buttonDownPath; }
            else if (hover) { path = this.buttonHoverPath; }
        }
        if (path != "") {
            CKitSlice.NineSlice(c, path, x, y, w, h, CrawlerView.ButtonCorner);
        } else {
            int bg = primary ? CrawlerPalette.ButtonPrimary : CrawlerPalette.ButtonFace;
            if (hover) { bg = primary ? CrawlerPalette.Torch : CrawlerPalette.ButtonFaceHover; }
            this.FillRound(c, x, y, w, h, 6, bg);
            CDraw.RingRect(c, x, y, w, h, 2,
                (CrawlerPalette.ButtonEdge >> 16) & 0xFF,
                (CrawlerPalette.ButtonEdge >> 8) & 0xFF,
                CrawlerPalette.ButtonEdge & 0xFF, 255);
        }
        int text = primary ? CrawlerPalette.TextInk : CrawlerPalette.Parchment;
        CText.DrawCenteredShadowPx(c, label, x + w / 2, y + h / 2 - 11, 18, text, CrawlerPalette.TextShadow, 1, 2);
    }
}
