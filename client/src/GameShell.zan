using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Game.Foundation;
using Game.Foundation.Gui;

// 地底爬行 · CRAWLER 的外壳：存档（最深层数 / 累计金币 / 累计击杀 /
// 通关次数 / 开局次数）+ 设置（怪物凶险 / 视野半径 / 音效）+ 设置浮层。
//
// 存档基座（原子写 + 备份回退 + 版本号）与设置逻辑层（档位计算 + 校验 +
// 落盘）都在公共包 Game.Foundation 里；这里只留"这个游戏存什么、设置有哪
// 几项"——换个游戏换的正是这两行。
public class GameShell {
    GameSaveStore store;
    GameSettings settings;
    SettingsModel model;
    SettingsOverlay overlay;
    int bestDepth;      // 历史最深层数
    int totalGold;      // 累计金币
    int totalKills;     // 累计击杀
    int clears;         // 通关次数（打满第 5 层）
    int runs;           // 开局次数

    public GameShell() {
        string dir = GameShell.SaveDir();
        Directory.CreateDirectory(dir);
        this.store = new GameSaveStore(dir, "crawler", 2);
        this.settings = new GameSettings().At(dir + "/settings.json");
        // 怪物凶险：怪的数量与伤害。
        this.settings.AddIntChoice("difficulty", "怪物凶险", 2, new List<int> { 1, 2, 3 });
        // 视野半径：玩家能看见多远（照亮的地牢范围）。
        this.settings.AddIntChoice("light", "视野半径", 6, new List<int> { 4, 6, 8 });
        // 音效开关：关掉后游戏照常跑，只是不出声。
        this.settings.AddBool("sound", "音效", true);
        this.settings.Load();
        this.model = new SettingsModel(this.settings);
        this.overlay = new SettingsOverlay(this.model);
        this.overlay.SetTitle("设置");
        this.overlay.SetCloseText("关闭");
        this.Load();
    }

    // 存档目录：%LOCALAPPDATA%/Crawler（可用 CRAWLER_SAVE 环境变量覆盖，
    // 测试脚本靠它把存档落在临时目录里，不污染玩家机器）。
    static string SaveDir() {
        string overridden = Environment.GetEnvironmentVariable("CRAWLER_SAVE");
        if (overridden != "") { return overridden; }
        string basePath = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        if (basePath == "") { basePath = Directory.GetCurrentDirectory(); }
        return basePath + "/Crawler";
    }

    public SettingsOverlay Overlay() { return this.overlay; }
    public int BestDepth() { return this.bestDepth; }
    public int TotalGold() { return this.totalGold; }
    public int TotalKills() { return this.totalKills; }
    public int Clears() { return this.clears; }
    public int Runs() { return this.runs; }

    // 怪物凶险档（1 温吞 / 2 寻常 / 3 凶残）——游戏逻辑读它算怪物数量与伤害。
    public int Difficulty() {
        if (this.settings == null) { return 2; }
        return this.settings.GetInt("difficulty");
    }

    // 视野半径档（4/6/8 格）。
    public int LightRadius() {
        if (this.settings == null) { return 6; }
        return this.settings.GetInt("light");
    }

    // 音效开关。
    public bool Sound() {
        if (this.settings == null) { return true; }
        return this.settings.GetBool("sound");
    }

    // 读档：没有存档就用默认值，不报错。
    public void Load() {
        JsonValue data = this.store.Load(0);
        if (data == null) {
            this.bestDepth = 0; this.totalGold = 0; this.totalKills = 0;
            this.clears = 0; this.runs = 0;
            return;
        }
        this.bestDepth = data.Int("bestDepth", 0);
        this.totalGold = data.Int("totalGold", 0);
        this.totalKills = data.Int("totalKills", 0);
        this.clears = data.Int("clears", 0);
        this.runs = data.Int("runs", 0);
    }

    // 一局结束：把本局成绩并进累计（最深层数只增不减）。
    public void RecordRun(int depth, int kills, int gold, bool won) {
        if (depth > this.bestDepth) { this.bestDepth = depth; }
        this.totalKills = this.totalKills + kills;
        this.totalGold = this.totalGold + gold;
        if (won) { this.clears = this.clears + 1; }
    }

    // 存档：开局次数 +1 后落盘。
    public void Save() {
        this.runs = this.runs + 1;
        JsonValue data = JsonValue.NewObject();
        data.PutInt("bestDepth", this.bestDepth);
        data.PutInt("totalGold", this.totalGold);
        data.PutInt("totalKills", this.totalKills);
        data.PutInt("clears", this.clears);
        data.PutInt("runs", this.runs);
        this.store.Save(0, data);
    }
}
